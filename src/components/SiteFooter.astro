---
import { PROFILE } from "../lib/data";
---

<footer class="site-footer">
  <span>Diagram not to scale. Line colors after the São Paulo Metrô.</span>
  <span>Hidden service: ↑↑↓↓←→←→BA</span>
  <span>© {new Date().getFullYear()} {PROFILE.name} · {PROFILE.address.locality}, SP</span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    max-width: var(--max);
    margin: 28px auto 0;
    padding: 18px var(--pad) 26px;
    border-top: 1px solid var(--color-hair);
    color: var(--color-grey);
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>
