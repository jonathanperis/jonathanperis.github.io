---
import SectionHead from "../SectionHead.astro";
import { AVAILABILITY, PROFILE, SOCIALS } from "../../lib/data";

const contacts = [
  { label: "Email", value: PROFILE.email, href: `mailto:${PROFILE.email}`, event: "cta_click", track: "info_email" },
  // social_click keeps the GA4 event name the previous footer icons reported.
  ...SOCIALS.map((social) => ({ label: social.label, value: social.handle, href: social.href, event: "social_click", track: social.label })),
];
---

<section id="info" class="page-section" aria-labelledby="info-heading">
  <SectionHead id="info-heading" title="Customer Information" note="Contact">
    <span slot="symbol" class="isym" aria-hidden="true">i</span>
  </SectionHead>
  <div class="info">
    <div class="board">
      <p class="k"><i aria-hidden="true"></i>Now boarding</p>
      <h3>{AVAILABILITY.full}</h3>
      <p>Backend architecture, .NET and Azure, for fintech and beyond. Working remotely with US teams from {PROFILE.address.locality}, on the São Paulo coast.</p>
      <dl>
        <dt>Based</dt><dd>{PROFILE.location}</dd>
        <dt>Works</dt><dd>Remote, with US teams</dd>
        <dt>Timetable</dt>
        <dd>
          <a href="/resume/" data-track-event="cta_click" data-track-label="info_resume">Resume</a>
          <span class="dsep">·</span>
          <a href="/cv_jonathan_peris.pdf" data-track-event="cta_click" data-track-label="info_pdf">PDF</a>
        </dd>
      </dl>
    </div>
    <ul>
      {contacts.map((contact) => (
        <li>
          <a
            href={contact.href}
            target={contact.href.startsWith("http") ? "_blank" : undefined}
            rel={contact.href.startsWith("http") ? "noreferrer noopener" : undefined}
            data-track-event={contact.event}
            data-track-label={contact.track}
          >
            <span class="lbl">{contact.label}</span>
            <span class="v">{contact.value}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h12M10 4l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .isym {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding-top: 3px;
    background: #fff;
    color: var(--color-sign);
    font-family: Georgia, serif;
    font-size: 26px;
    font-style: italic;
    font-weight: 900;
    line-height: 1;
  }
  .info {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    border: 3px solid var(--color-ink);
    border-top: 0;
  }
  .board {
    padding: 28px 34px;
    border-right: 3px solid var(--color-ink);
    background: var(--color-card);
  }
  .k {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .k i {
    display: block;
    width: 12px;
    height: 12px;
    background: var(--color-line-5);
  }
  h3 {
    margin-top: 14px;
    font-size: 44px;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .board > p:not(.k) {
    max-width: 520px;
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.5;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 18px;
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--color-hair);
    font-size: 15px;
  }
  dt {
    padding-top: 2px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  dd a {
    border-bottom: 2px solid var(--color-ink);
    font-weight: 700;
  }
  ul {
    list-style: none;
  }
  li a {
    display: grid;
    grid-template-columns: 120px 1fr 26px;
    align-items: center;
    padding: 16px 30px 13px;
    border-bottom: 1px solid var(--color-ink);
    font-size: 18px;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease;
  }
  li:last-child a {
    border-bottom: 0;
  }
  .lbl {
    color: var(--color-grey);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .v {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  li svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: square;
    transition: transform 0.15s ease;
  }
  li a:hover,
  li a:focus-visible {
    background: var(--color-sign);
    color: #fff;
  }
  li a:hover .lbl,
  li a:focus-visible .lbl {
    color: #cfcfca;
  }
  li a:hover svg {
    transform: translateX(4px);
  }
  @media (max-width: 900px) {
    .info {
      grid-template-columns: 1fr;
    }
    .board {
      padding: 24px 20px;
      border-right: 0;
      border-bottom: 3px solid var(--color-ink);
    }
    h3 {
      font-size: 32px;
    }
    li a {
      grid-template-columns: 1fr 22px;
      gap: 2px 10px;
      padding: 14px 18px 12px;
    }
    .v {
      grid-column: 1;
      font-size: 15px;
    }
    li svg {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
