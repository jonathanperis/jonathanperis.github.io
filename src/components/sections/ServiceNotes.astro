---
import RouteBullet from "../RouteBullet.astro";
import SectionHead from "../SectionHead.astro";
import { ENGINEERING_PRINCIPLES } from "../../lib/data";
import type { LineId } from "../../lib/metro";

/** Signage framing for each principle in data.ts, in the same order. */
const ADVISORIES: Array<{ line?: LineId; effect: string }> = [
  { effect: "In effect: nights and weekends, too." },
  { line: 4, effect: "Patterns run only where they pay their fare." },
  { line: 3, effect: "Frequent, small departures." },
];
---

<section id="notes" class="page-section" aria-labelledby="notes-heading">
  <SectionHead id="notes-heading" title="Service Notes" note="In effect on all lines">
    <svg slot="symbol" class="warn big" viewBox="0 0 28 25" aria-hidden="true"><use href="#warn" /></svg>
  </SectionHead>
  <svg width="0" height="0" class="defs" aria-hidden="true">
    <symbol id="warn" viewBox="0 0 28 25">
      <path d="M14 2 L26 23 H2 Z" fill="#FFC20E" stroke="#151515" stroke-width="2.4" stroke-linejoin="round" />
      <path d="M14 9v7" stroke="#151515" stroke-width="3" />
      <circle cx="14" cy="19.6" r="1.7" fill="#151515" />
    </symbol>
  </svg>
  <div class="notes">
    {ENGINEERING_PRINCIPLES.map((principle, i) => {
      const advisory = ADVISORIES[i];
      return (
        <article>
          <p class="hd">
            <svg class="warn" viewBox="0 0 28 25" aria-hidden="true"><use href="#warn" /></svg>
            Advisory {i + 1}
            <span class="scope">{advisory?.line ? <RouteBullet line={advisory.line} size={12} label={`Line ${advisory.line}`} /> : "all lines"}</span>
          </p>
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
          {advisory && <p class="eff">{advisory.effect}</p>}
        </article>
      );
    })}
  </div>
</section>

<style>
  .defs {
    position: absolute;
  }
  .warn {
    flex: none;
    width: 28px;
    height: 25px;
  }
  .warn.big {
    width: 30px;
    height: 27px;
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 3px solid var(--color-ink);
    border-top: 0;
    background: var(--color-card);
  }
  article {
    padding: 22px 28px 24px;
    border-right: 1px solid var(--color-ink);
  }
  article:last-child {
    border-right: 0;
  }
  .hd {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .scope {
    margin-left: auto;
    color: var(--color-grey);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  h3 {
    margin-top: 16px;
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.02;
  }
  article > p:not(.hd) {
    margin-top: 12px;
    color: #2a2a28;
    font-size: 16.5px;
    line-height: 1.5;
  }
  article > p.eff {
    margin-top: 18px;
    padding-top: 10px;
    border-top: 1px solid var(--color-hair);
    color: var(--color-grey);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  @media (max-width: 900px) {
    .notes {
      grid-template-columns: 1fr;
    }
    article {
      border-right: 0;
      border-bottom: 1px solid var(--color-ink);
    }
    article:last-child {
      border-bottom: 0;
    }
    h3 {
      font-size: 25px;
    }
  }
</style>
