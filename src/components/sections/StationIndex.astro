---
import RouteBullet from "../RouteBullet.astro";
import SectionHead from "../SectionHead.astro";
import { EDUCATION } from "../../lib/data";
import { STATIONS, TERMINUS, stationPeriod, stationTags, type LineId } from "../../lib/metro";

/** Lines drawn in the vertical strip, with their x offset in px (Azure left, Career centre, .NET right). */
const STRIP: Array<{ line: LineId; x: number }> = [
  { line: 3, x: 14 },
  { line: 1, x: 30 },
  { line: 2, x: 46 },
];

const newestFirst = [...STATIONS].reverse();
const rows = newestFirst.map((station, i) => {
  const older = newestFirst[i + 1];
  const bars = STRIP.filter(({ line }) => station.lines.includes(line)).map((bar) => ({
    ...bar,
    // A line that the next-older station does not serve starts here, so its bar stops at the capsule.
    startsHere: !older?.lines.includes(bar.line),
  }));
  const xs = bars.map((bar) => bar.x);
  const [from, to] = stationPeriod(station);
  return {
    station,
    bars,
    capsule: { left: Math.min(...xs) - 4, width: Math.max(...xs) - Math.min(...xs) + 20 },
    from,
    to: to === "Present" ? "present" : to,
    isNow: station === TERMINUS,
  };
});
---

<section id="stations" class="page-section" aria-labelledby="stations-heading">
  <SectionHead id="stations-heading" title="Station Index" line={1} note="Newest first · tap a station on the map to jump here" />
  <ol class="stations">
    {rows.map(({ station, bars, capsule, from, to, isNow }) => (
      <li id={`stn-${station.id}`} class:list={["stn", { now: isNow }]} data-lines={station.lines.join(" ")}>
        <div class="yr">{from}<small>— {to}</small></div>
        <div class="strip" aria-hidden="true">
          {bars.map((bar) => <i data-line={bar.line} class:list={{ starts: bar.startsHere }} style={`left: ${bar.x}px`}></i>)}
          <span class="cap" style={`left: ${capsule.left}px; width: ${capsule.width}px`}></span>
        </div>
        <div class="body">
          {isNow && <span class="here">You are here</span>}
          <p class="yrm">{from} — {to}</p>
          <h3>{station.name}</h3>
          {station.roles.map((role) => (
            <>
              <p class="role">
                {role.title}
                {station.roles.length > 1 && <span><b class="dsep">·</b>{role.period}</span>}
                {role.location.split(" · ").map((part) => <span><b class="dsep">·</b>{part}</span>)}
              </p>
              <p class="desc">{role.description}</p>
            </>
          ))}
        </div>
        <div class="side">
          <div class="lines">
            {station.lines.map((line) => <RouteBullet line={line} size={13} label={`Line ${line}`} />)}
          </div>
          <p class="via">{stationTags(station).join(" · ")}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="depot"><span class="k">Depot</span><span><b>{EDUCATION.institution.split(" — ")[0]}</b> — {EDUCATION.degree}, {EDUCATION.field}, {EDUCATION.period}</span></p>
</section>

<style>
  .stations {
    list-style: none;
  }
  .stn {
    position: relative;
    display: grid;
    grid-template-columns: 150px 96px 1fr 260px;
    scroll-margin-top: 16px;
  }
  /* Arriving from the map: the row flashes like a departure-board update. */
  .stn:target .body,
  .stn:target .side {
    animation: arrive 1.6s ease-out;
  }
  @keyframes arrive {
    from { background: #ffd94d; }
  }
  .yr {
    padding: 21px 22px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    text-align: right;
  }
  .yr small {
    display: block;
    margin-top: 3px;
    color: var(--color-grey);
    font-size: 12.5px;
    font-weight: 400;
  }
  .strip {
    position: relative;
  }
  .strip i {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12px;
    background: var(--line);
  }
  .strip i.starts {
    bottom: auto;
    height: 30px;
  }
  .stn:first-child .strip i {
    top: 30px;
  }
  .stn:first-child .strip i.starts {
    height: 0;
  }
  .strip .cap {
    position: absolute;
    top: 20px;
    height: 19px;
    border: 3.5px solid var(--color-ink);
    border-radius: 10px;
    background: #fff;
  }
  .body {
    padding: 15px 0 17px 6px;
    border-bottom: 1px solid var(--color-hair);
  }
  .stn:first-child .body {
    padding-top: 10px;
  }
  .stn:last-child .body,
  .stn:last-child .side {
    border-bottom: 0;
  }
  h3 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.012em;
    line-height: 1.1;
  }
  .now h3 {
    font-size: 31px;
  }
  .here {
    display: inline-block;
    margin: 4px 0 6px;
    padding: 4px 8px 2px;
    background: var(--color-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .role {
    margin-top: 6px;
    font-size: 15.5px;
    font-weight: 600;
  }
  .role span {
    color: var(--color-grey);
    font-weight: 500;
  }
  .desc {
    max-width: 780px;
    margin-top: 4px;
    color: #2a2a28;
    font-size: 15.5px;
    line-height: 1.45;
  }
  .yrm {
    display: none;
    margin-bottom: 4px;
    color: var(--color-grey);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  .side {
    padding: 20px 0 0 24px;
    border-bottom: 1px solid var(--color-hair);
  }
  .lines {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .via {
    margin-top: 10px;
    color: var(--color-grey);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .depot {
    display: grid;
    grid-template-columns: 246px 1fr;
    padding: 12px 0;
    border-top: 2px solid var(--color-ink);
    font-size: 15px;
  }
  .depot .k {
    padding-top: 2px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .depot b {
    font-weight: 800;
  }
  @media (max-width: 760px) {
    .stn {
      grid-template-columns: 62px 1fr;
    }
    .yr {
      display: none;
    }
    .strip {
      grid-row: 1 / 3;
      margin-left: -8px;
    }
    .body {
      padding: 20px 0 14px 4px;
      border-bottom: 0;
    }
    .side {
      grid-column: 2;
      padding: 0 0 22px 4px;
    }
    .yrm {
      display: block;
    }
    h3 { font-size: 23px; }
    .now h3 { font-size: 27px; }
    .depot {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
