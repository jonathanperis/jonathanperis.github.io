---
import { Font } from 'astro:assets';
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';
import JsonLd from '../components/JsonLd.astro';
import { YEARS_OF_EXPERIENCE } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Jonathan Peris — Software Engineer',
  description = `Software Engineer specializing in .NET and Fintech. ${YEARS_OF_EXPERIENCE} years building enterprise-grade systems with modern cloud-native technologies.`,
  canonical = '/',
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site).href;
// Square share image, so it is advertised with its real size and a square-friendly Twitter card.
const ogImage = new URL('/profile-image-sharing.jpeg', Astro.site).href;

const keywords = [
  'Jonathan Peris', 'Software Engineer', '.NET', 'C#', 'Fintech',
  'Azure', 'Microservices', 'CQRS', 'DDD', 'Clean Architecture',
  'Backend Developer', 'Cloud-Native',
].join(', ');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <!-- Marks JS as available so reveal animations can hide content; without JS everything stays visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Jonathan Peris" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Jonathan Peris" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@jperis_silva" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Self-hosted fonts (Astro Fonts API) -->
    <Font cssVariable="--font-dm-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ subset: 'latin' }]} />

    <link rel="alternate" hreflang="en" href={canonicalUrl} />

    <JsonLd />
  </head>
  <body class="antialiased">
    <slot />
    <Analytics />
  </body>
</html>
