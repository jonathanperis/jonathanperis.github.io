---
import RootLayout from '../layouts/RootLayout.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import SiteSign from '../components/SiteSign.astro';
import StatusStrip from '../components/StatusStrip.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Terminal from '../components/Terminal.astro';
import MetroMap from '../components/sections/MetroMap.astro';
import StationIndex from '../components/sections/StationIndex.astro';
import Connections from '../components/sections/Connections.astro';
import LineGuide from '../components/sections/LineGuide.astro';
import ServiceNotes from '../components/sections/ServiceNotes.astro';
import CustomerInfo from '../components/sections/CustomerInfo.astro';
import { fetchRepos } from '../lib/github';

const projects = await fetchRepos();
const pins = projects.filter((project) => project.pinned);
---

<RootLayout>
  <ScrollProgress />
  <SiteSign />
  <StatusStrip />

  <main>
    <MetroMap pins={pins} />
    <StationIndex />
    <Connections projects={projects} />
    <LineGuide />
    <ServiceNotes />
    <CustomerInfo />
  </main>

  <SiteFooter />
  <Terminal />
</RootLayout>
