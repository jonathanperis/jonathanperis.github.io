---
import RootLayout from '../layouts/RootLayout.astro';
import { PROFILE, SKILLS, EDUCATION, EXPERIENCES, YEARS_OF_EXPERIENCE } from '../lib/data';

const contactLinks = [
  { label: PROFILE.email, href: `mailto:${PROFILE.email}` },
  { label: PROFILE.location },
  { label: PROFILE.linkedin, href: `https://www.${PROFILE.linkedin}/` },
  { label: PROFILE.github, href: `https://${PROFILE.github}` },
  { label: PROFILE.website, href: `https://${PROFILE.website}/` },
];
---

<RootLayout
  title="Resume — Jonathan Peris"
  description={`Professional resume of Jonathan Peris — Software Engineer with ${YEARS_OF_EXPERIENCE} years of experience in .NET and Fintech.`}
  canonical="/resume/"
>
  <!-- Print / Download bar — hidden when printing -->
  <div class="print:hidden sticky top-0 z-50 bg-bg border-b border-border">
    <div class="max-w-[800px] mx-auto px-8 py-3 flex items-center justify-between">
      <a href="/" class="font-mono text-sm text-muted hover:text-green transition-colors">
        &larr; Back to portfolio
      </a>
      <button
        type="button"
        data-print
        data-track-event="cta_click"
        data-track-label="resume_print"
        class="font-mono text-xs text-bg bg-green hover:bg-green-dim px-4 py-1.5 rounded-md transition-colors font-semibold"
      >
        Print / Save as PDF
      </button>
    </div>
  </div>

  <!-- Resume content — optimized for A4 print -->
  <main class="resume-page max-w-[800px] mx-auto px-8 py-10 print:px-0 print:py-0 print:max-w-none">

    <!-- Header -->
    <header class="mb-6 print:mb-4">
      <h1 class="text-3xl font-bold text-text print:text-black tracking-tight">
        {PROFILE.name}
      </h1>
      <p class="mt-1 text-lg text-green print:text-gray-700 font-medium">
        {PROFILE.title}
      </p>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted print:text-gray-500 font-mono">
        {contactLinks.map(({ label, href }) => href
          ? <a href={href} class="hover:text-green transition-colors">{label}</a>
          : <span>{label}</span>)}
      </div>
    </header>

    <hr class="border-border print:border-gray-300 mb-5 print:mb-3" />

    <!-- Summary -->
    <section class="mb-6 print:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-widest text-green print:text-gray-800 mb-2 print:mb-1">
        Summary
      </h2>
      <p class="text-sm text-muted print:text-gray-600 leading-relaxed">
        {PROFILE.summary}
      </p>
    </section>

    <!-- Skills -->
    <section class="mb-6 print:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-widest text-green print:text-gray-800 mb-2 print:mb-1">
        Technical Skills
      </h2>
      <div class="grid grid-cols-2 gap-x-8 gap-y-1 text-sm">
        <div>
          <span class="text-text print:text-black font-medium">Languages: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.languages.join(', ')}</span>
        </div>
        <div>
          <span class="text-text print:text-black font-medium">Backend: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.backend.join(', ')}</span>
        </div>
        <div>
          <span class="text-text print:text-black font-medium">Architecture: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.architecture.join(', ')}</span>
        </div>
        <div>
          <span class="text-text print:text-black font-medium">Cloud &amp; DevOps: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.cloud.join(', ')}</span>
        </div>
        <div>
          <span class="text-text print:text-black font-medium">Databases: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.databases.join(', ')}</span>
        </div>
        <div>
          <span class="text-text print:text-black font-medium">Frontend: </span>
          <span class="text-muted print:text-gray-600">{SKILLS.frontend.join(', ')}</span>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-6 print:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-widest text-green print:text-gray-800 mb-3 print:mb-2">
        Experience
      </h2>
      <div class="space-y-4 print:space-y-2">
        {EXPERIENCES.map((exp) => (
          <div class="print:break-inside-avoid">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-sm font-semibold text-text print:text-black">
                {exp.title} <span class="font-normal text-muted print:text-gray-500">· {exp.company}</span>
              </h3>
              <span class="text-xs text-muted print:text-gray-500 font-mono whitespace-nowrap shrink-0">
                {exp.period}
              </span>
            </div>
            <p class="text-xs text-dim print:text-gray-400 font-mono mt-0.5">
              {exp.location}
            </p>
            <p class="text-sm text-muted print:text-gray-600 leading-relaxed mt-1">
              {exp.description}
            </p>
            <div class="flex flex-wrap gap-1 mt-1.5">
              {exp.tags.map((t) => (
                <span class="text-[10px] font-mono text-green print:text-gray-600 bg-green-tint print:bg-gray-100 px-1.5 py-0.5 rounded">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-6 print:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-widest text-green print:text-gray-800 mb-2 print:mb-1">
        Education
      </h2>
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="text-sm font-semibold text-text print:text-black">
          {EDUCATION.degree} — {EDUCATION.field}
        </h3>
        <span class="text-xs text-muted print:text-gray-500 font-mono whitespace-nowrap shrink-0">
          {EDUCATION.period}
        </span>
      </div>
      <p class="text-xs text-dim print:text-gray-400 font-mono mt-0.5">
        {EDUCATION.institution}
      </p>
      <p class="text-sm text-muted print:text-gray-600 leading-relaxed mt-1">
        {EDUCATION.description}
      </p>
    </section>
  </main>

  <script>
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  </script>

  <!-- Print styles -->
  <style>
    @media print {
      body {
        background: white !important;
        color: black !important;
        font-size: 11px !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      body::before {
        display: none !important;
      }
      .resume-page {
        padding: 0.4in 0.5in !important;
        max-width: none !important;
      }
      @page {
        size: A4;
        margin: 0;
      }
    }
  </style>
</RootLayout>
