---
import RootLayout from '../layouts/RootLayout.astro';
import { PROFILE, SKILLS, SKILL_GROUPS, EDUCATION, EXPERIENCES, YEARS_OF_EXPERIENCE } from '../lib/data';

const contactLinks = [
  { label: PROFILE.email, href: `mailto:${PROFILE.email}` },
  { label: PROFILE.location },
  { label: PROFILE.github, href: `https://${PROFILE.github}` },
  { label: PROFILE.linkedin, href: `https://www.${PROFILE.linkedin}/` },
];

/** Resume labels for each skill group, in reading order. */
const SKILL_LABELS: Record<(typeof SKILL_GROUPS)[number]['key'], string> = {
  languages: 'Programming',
  backend: 'Backend',
  architecture: 'Architecture',
  cloud: 'Cloud & DevOps',
  databases: 'Databases',
  frontend: 'Frontend',
};
const skillRows = (Object.keys(SKILL_LABELS) as Array<keyof typeof SKILL_LABELS>).map((key) => ({
  label: SKILL_LABELS[key],
  values: SKILLS[key].join(', '),
}));

// The years-of-experience phrase is emphasized in the summary, wherever data.ts puts it.
const yearsPhrase = `${YEARS_OF_EXPERIENCE} years of experience`;
const [summaryBefore, summaryAfter] = PROFILE.summary.includes(yearsPhrase)
  ? PROFILE.summary.split(yearsPhrase)
  : [PROFILE.summary, undefined];

/** One bullet per sentence of the role description. ".NET" never splits: a break needs ". " before a capital. */
const bullets = (text: string) => text.split(/(?<=\.)\s+(?=[A-Z])/);
---

<RootLayout
  title="Resume — Jonathan Peris"
  description={`Professional resume of Jonathan Peris — Software Engineer with ${YEARS_OF_EXPERIENCE} years of experience in .NET and Fintech.`}
  canonical="/resume/"
>
  <!-- Screen-only toolbar -->
  <div class="toolbar">
    <div>
      <a href="/">&larr; Back to portfolio</a>
      <button type="button" data-print data-track-event="cta_click" data-track-label="resume_print">Print / Save as PDF</button>
    </div>
  </div>

  <main class="sheet">
    <header>
      <h1>{PROFILE.name}</h1>
      <p class="role">{PROFILE.title}<span class="sep">·</span>.NET &amp; Azure</p>
      <p class="contact">
        {contactLinks.map(({ label, href }) => (href ? <a href={href}>{label}</a> : <span>{label}</span>))}
      </p>
      <span class="accent" aria-hidden="true"></span>
    </header>

    <section aria-labelledby="summary-h">
      <h2 id="summary-h">Summary</h2>
      <p class="summary">
        {summaryBefore}{summaryAfter !== undefined && <><strong>{yearsPhrase}</strong>{summaryAfter}</>}
      </p>
    </section>

    <section aria-labelledby="skills-h">
      <h2 id="skills-h">Technical Skills</h2>
      <dl class="skills">
        {skillRows.map((row) => <><dt>{row.label}</dt><dd>{row.values}</dd></>)}
      </dl>
    </section>

    <section aria-labelledby="experience-h">
      <h2 id="experience-h">Experience</h2>
      {EXPERIENCES.map((exp) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{exp.title}<span class="org"><span class="sep">·</span>{exp.company}</span></h3>
            <span class="date">{exp.period}</span>
          </div>
          <p class="meta">{exp.location}</p>
          <ul>
            {bullets(exp.description).map((sentence) => <li>{sentence}</li>)}
          </ul>
          <p class="stack"><strong>Stack:</strong> {exp.tags.join(', ')}</p>
        </article>
      ))}
    </section>

    <section aria-labelledby="education-h">
      <h2 id="education-h">Education</h2>
      <article class="entry">
        <div class="entry-head">
          <h3>{EDUCATION.degree} — {EDUCATION.field}</h3>
          <span class="date">{EDUCATION.period}</span>
        </div>
        <p class="meta">{EDUCATION.institution}</p>
        <p class="body">{EDUCATION.description}</p>
      </article>
    </section>
  </main>

  <script>
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  </script>

  <style>
    /* ── Screen: an A4 sheet on the site's paper background ── */
    .toolbar {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--color-sign);
      color: #fff;
    }
    .toolbar > div {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 210mm;
      margin: 0 auto;
      padding: 12px 0;
    }
    .toolbar a {
      border-bottom: 2px solid transparent;
      font-size: 14px;
      font-weight: 700;
    }
    .toolbar a:hover {
      border-color: #fff;
    }
    .toolbar button {
      padding: 8px 16px 6px;
      background: var(--color-line-1);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .toolbar button:hover {
      background: #fff;
      color: var(--color-ink);
    }
    .sheet {
      max-width: 210mm;
      margin: 32px auto 64px;
      padding: 16mm 17mm;
      border: 1px solid var(--color-hair);
      background: #fff;
      color: #2a2a28;
      font-size: 10.5pt;
      line-height: 1.5;
    }

    /* ── Header ── */
    h1 {
      color: var(--color-ink);
      font-size: 27pt;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.05;
    }
    .role {
      margin-top: 4px;
      color: var(--color-line-1);
      font-size: 14pt;
      font-weight: 600;
    }
    /* Overpass sets "·" off-centre; the mono face centres it. */
    .sep {
      margin: 0 0.3em;
      font-family: var(--font-mono);
      font-weight: 400;
    }
    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 18px;
      margin-top: 10px;
      color: var(--color-grey);
      font-family: var(--font-mono);
      font-size: 8.5pt;
    }
    .contact a:hover {
      color: var(--color-line-1);
    }
    .accent {
      display: block;
      width: 44px;
      height: 3px;
      margin-top: 14px;
      background: var(--color-line-1);
    }

    /* ── Section heads: red caps followed by a hairline ── */
    h2 {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 20px 0 8px;
      color: var(--color-line-1);
      font-size: 8.5pt;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      break-after: avoid;
    }
    h2::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--color-hair);
    }

    .summary strong {
      color: var(--color-ink);
      font-weight: 700;
    }

    .skills {
      display: grid;
      grid-template-columns: 44mm 1fr;
      gap: 3px 12px;
    }
    .skills dt {
      color: var(--color-ink);
      font-weight: 700;
    }

    /* ── Entries ── */
    .entry {
      margin-top: 12px;
    }
    .entry-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      break-after: avoid;
    }
    h3 {
      color: var(--color-ink);
      font-size: 11pt;
      font-weight: 800;
    }
    .org {
      color: var(--color-line-1);
      font-weight: 500;
    }
    .date {
      flex: none;
      color: var(--color-grey);
      font-family: var(--font-mono);
      font-size: 8.5pt;
      white-space: nowrap;
    }
    .meta {
      color: #8a8a85;
      font-family: var(--font-mono);
      font-size: 8pt;
      break-after: avoid;
    }
    ul {
      margin-top: 4px;
      list-style: none;
    }
    li {
      position: relative;
      padding-left: 16px;
      break-inside: avoid;
    }
    li + li {
      margin-top: 2px;
    }
    li::before {
      content: "";
      position: absolute;
      top: calc(0.75em - 2.5px); /* centre of the first line */
      left: 3px;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--color-line-1);
    }
    .stack {
      margin-top: 5px;
      color: var(--color-grey);
      font-family: var(--font-mono);
      font-size: 8pt;
      break-before: avoid;
    }
    .stack strong {
      color: var(--color-ink);
      font-weight: 700;
    }
    .body {
      margin-top: 4px;
    }

    /* screen only: an A4 print area is also narrower than 760px */
    @media screen and (max-width: 760px) {
      .toolbar > div {
        padding: 12px 18px;
      }
      .sheet {
        margin: 0;
        padding: 28px 18px;
        border: 0;
      }
      .skills {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .skills dd {
        margin-bottom: 6px;
      }
      .entry-head {
        flex-direction: column;
        gap: 0;
      }
    }

    /* ── Print: the sheet becomes the A4 page, in full color ── */
    @page {
      size: A4;
      margin: 14mm 17mm;
    }
    @media print {
      :global(html),
      :global(body) {
        background: #fff;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .toolbar {
        display: none;
      }
      .sheet {
        max-width: none;
        margin: 0;
        padding: 0;
        border: 0;
        font-size: 9.6pt;
        line-height: 1.45;
      }
      .entry {
        margin-top: 10px;
      }
    }
  </style>
</RootLayout>
